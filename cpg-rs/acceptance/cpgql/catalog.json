{
  "schemaVersion": 1,
  "oracle": "joern-v4.0.555",
  "tiers": [
    {
      "id": "native-core-1",
      "status": "implemented",
      "cases": [
        {"id": "all-methods", "query": "cpg.method"},
        {"id": "method-regex", "query": "cpg.method.name(\"main|helper\")"},
        {"id": "method-full-name", "query": "cpg.method.fullName(\".*main.*\")"},
        {"id": "method-parameter-names", "query": "cpg.method.name(\"main\").parameter.name.l"},
        {"id": "method-return", "query": "cpg.method.name(\"main\").methodReturn"},
        {"id": "all-calls", "query": "cpg.call"},
        {"id": "call-regex", "query": "cpg.call.name(\"getenv|strcpy\")"},
        {"id": "call-code", "query": "cpg.call.code(\"strcpy\\\\(.*\")"},
        {"id": "call-line", "query": "cpg.call.lineNumber(4)"},
        {"id": "call-argument", "query": "cpg.call.name(\"strcpy\").argument"},
        {"id": "call-second-argument", "query": "cpg.call.name(\"strcpy\").argument(2).code"},
        {"id": "call-owner", "query": "cpg.call.method.fullName.dedup"},
        {"id": "call-file", "query": "cpg.call.file.filename.dedup"},
        {"id": "call-count", "query": "cpg.call.size"},
        {"id": "call-limit", "query": "cpg.call.limit(10).name"},
        {"id": "callee", "query": "cpg.call.callee.fullName"},
        {"id": "callers", "query": "cpg.method.callIn.method.name.dedup"},
        {"id": "ast-children", "query": "cpg.method.ast"},
        {"id": "ast-parent", "query": "cpg.identifier.astParent"},
        {"id": "cfg-successor", "query": "cpg.call.cfgNext"},
        {"id": "cfg-predecessor", "query": "cpg.call.cfgPrev"},
        {"id": "symbol-reference", "query": "cpg.identifier.refsTo"},
        {"id": "referenced-type", "query": "cpg.identifier.typ.fullName"},
        {"id": "reaching-def-in", "query": "cpg.call.reachingDefIn"},
        {"id": "reaching-def-out", "query": "cpg.call.reachingDefOut"},
        {"id": "labels", "query": "cpg.all.label.dedup"}
      ]
    },
    {
      "id": "native-core-2",
      "status": "implemented",
      "cases": [
        {"id": "selector-shorthand", "query": "cpg.method(\"main\").name"},
        {"id": "traversal-shorthand", "query": "cpg.method(\"main\").call(\"getenv|strcpy\").name"},
        {"id": "name-exact", "query": "cpg.call.nameExact(\"getenv\", \"strcpy\").name"},
        {"id": "name-not", "query": "cpg.call.nameNot(\"<operator>.*\").name"},
        {"id": "line-greater", "query": "cpg.call.lineNumberGt(3).code"},
        {"id": "line-greater-equal", "query": "cpg.call.lineNumberGte(3).code"},
        {"id": "line-less", "query": "cpg.call.lineNumberLt(20).code"},
        {"id": "line-less-equal", "query": "cpg.call.lineNumberLte(20).code"},
        {"id": "kind-filter", "query": "cpg.method(\"main\").ast.isCall.name"},
        {"id": "ast-descendants", "query": "cpg.method(\"main\").ast.code"},
        {"id": "ast-direct-children", "query": "cpg.method(\"main\").astChildren.label"},
        {"id": "ast-ancestors", "query": "cpg.call(\"strcpy\").inAst.isMethod.name"},
        {"id": "parent-block", "query": "cpg.call(\"strcpy\").parentBlock.code"},
        {"id": "contained-calls", "query": "cpg.method(\"main\").call.name"},
        {"id": "contained-identifiers", "query": "cpg.method(\"main\").identifier.name"},
        {"id": "where-positive", "query": "cpg.method.where(_.call.name(\"strcpy\")).name"},
        {"id": "where-negative", "query": "cpg.method.whereNot(_.call.name(\"strcpy\")).name"},
        {"id": "call-out", "query": "cpg.method(\"main\").callOut.name"},
        {"id": "parameter-out", "query": "cpg.method(\"main\").parameterOut.name"},
        {"id": "parameter-link", "query": "cpg.method(\"main\").parameter.parameterLink.name"},
        {"id": "condition", "query": "cpg.controlStructure.condition.code"},
        {"id": "true-body", "query": "cpg.controlStructure.whenTrue.code"},
        {"id": "false-body", "query": "cpg.controlStructure.whenFalse.code"},
        {"id": "take", "query": "cpg.call.take(2).name"},
        {"id": "head", "query": "cpg.method(\"main\").call.head.name"},
        {"id": "reachable-by-positive", "query": "cpg.call(\"strcpy\").argument(2).reachableBy(cpg.call(\"getenv\")).code"},
        {"id": "reachable-by-empty", "query": "cpg.call(\"strcpy\").argument(1).reachableBy(cpg.call(\"getenv\")).code"},
        {"id": "repeat-until", "query": "cpg.call(\"strcpy\").repeat(_.astParent)(_.until(_.isMethod)).name"},
        {"id": "repeat-times-emit", "query": "cpg.method(\"main\").repeat(_.astChildren)(_.emit.times(2)).label"}
      ]
    },
    {
      "id": "native-core-3",
      "status": "implemented",
      "cases": [
        {"id": "all-assignments", "query": "cpg.assignment.code"},
        {"id": "all-returns-alias", "query": "cpg.returns.code"},
        {"id": "filter-not", "query": "cpg.method.filterNot(_.call(\"strcpy\")).name"},
        {"id": "boolean-and", "query": "cpg.method.and(_.name(\"main\"), _.call(\"strcpy\")).name"},
        {"id": "boolean-or", "query": "cpg.method.or(_.name(\"main\"), _.name(\"helper\")).name"},
        {"id": "surrounding-call", "query": "cpg.identifier(\"input\").where(_.method(\"main\")).inCall.name"},
        {"id": "json-execution", "query": "cpg.method(\"main\").name.toJson"},
        {"id": "flow-paths", "query": "cpg.call(\"strcpy\").argument(2).reachableByFlows(cpg.call(\"getenv\")).p"},
        {"id": "repeat-max-depth", "query": "cpg.method(\"main\").repeat(_.astChildren)(_.emit(_.isCall).maxDepth(2)).name"},
        {"id": "dominates", "query": "cpg.call(\"getenv\").dominates.code"},
        {"id": "dominated-by", "query": "cpg.call(\"strcpy\").dominatedBy.code"},
        {"id": "post-dominates", "query": "cpg.call(\"strcpy\").postDominates.code"},
        {"id": "post-dominated-by", "query": "cpg.call(\"strcpy\").postDominatedBy.code"},
        {"id": "controls", "query": "cpg.call.code(\"argc > 1\").controls.code"},
        {"id": "controlled-by", "query": "cpg.call(\"strcpy\").controlledBy.code"}
      ]
    },
    {
      "id": "native-schema-4",
      "status": "implemented",
      "cases": [
        {"id":"select-annotation","query":"cpg.annotation"},
        {"id":"select-annotation-literal","query":"cpg.annotationLiteral"},
        {"id":"select-annotation-parameter","query":"cpg.annotationParameter"},
        {"id":"select-annotation-parameter-assign","query":"cpg.annotationParameterAssign"},
        {"id":"select-array-initializer","query":"cpg.arrayInitializer"},
        {"id":"select-binding","query":"cpg.binding"},
        {"id":"select-closure-binding","query":"cpg.closureBinding"},
        {"id":"select-comment","query":"cpg.comment"},
        {"id":"select-config-file","query":"cpg.configFile"},
        {"id":"select-dependency","query":"cpg.dependency"},
        {"id":"select-finding","query":"cpg.finding"},
        {"id":"select-import","query":"cpg.imports"},
        {"id":"select-jump-label","query":"cpg.jumpLabel"},
        {"id":"select-key-value-pair","query":"cpg.keyValuePair"},
        {"id":"select-tag","query":"cpg.tag"},
        {"id":"select-tag-node-pair","query":"cpg.tagNodePair"},
        {"id":"select-template-dom","query":"cpg.templateDom"},
        {"id":"select-type-argument","query":"cpg.typeArgument"},
        {"id":"descendant-annotation","query":"cpg.all.annotation"},
        {"id":"descendant-member","query":"cpg.typeDecl.member"},
        {"id":"source-file-edge","query":"cpg.method.sourceFile.filename"},
        {"id":"base-type-declaration","query":"cpg.typeDecl.baseTypeDecl.fullName"},
        {"id":"derived-type-declaration","query":"cpg.typeDecl.derivedTypeDecl.fullName"},
        {"id":"capture-edges","query":"cpg.closureBinding.captureOut"}
      ]
    },
    {
      "id": "native-properties-5",
      "status": "implemented",
      "cases": [
        {"id":"call-method-full-name","query":"cpg.call.methodFullName"},
        {"id":"call-dispatch-type","query":"cpg.call.dispatchType"},
        {"id":"method-external","query":"cpg.method.isExternal"},
        {"id":"method-external-filter","query":"cpg.method.isExternal(false).name"},
        {"id":"parameter-index","query":"cpg.parameter.index"},
        {"id":"parameter-variadic","query":"cpg.parameter.isVariadic"},
        {"id":"parameter-evaluation-strategy","query":"cpg.parameter.evaluationStrategy"},
        {"id":"metadata-language","query":"cpg.metaData.language"},
        {"id":"metadata-version","query":"cpg.metaData.version"},
        {"id":"column-number","query":"cpg.call.columnNumber"},
        {"id":"type-declaration-full-name","query":"cpg.typ.typeDeclFullName"},
        {"id":"inheritance-names","query":"cpg.typeDecl.inheritsFromTypeFullName"},
        {"id":"dynamic-type-hints","query":"cpg.call.dynamicTypeHintFullName"},
        {"id":"modifier-type","query":"cpg.modifier.modifierType"}
      ]
    }
  ]
}
