AST|METHOD NAME=luaV_fastgeti CODE=#define luaV_fastgeti(L,t,k,slot) \\n  (!ttistable(t)  \\n   ? (slot = NULL, 0)  /* not a table; 'slot' is NULL and result is 0 */  \\n   : (slot = (l_castS2U(k) - 1u < hvalue(t)->alimit) \\n              ? &hvalue(t)->array[k - 1] : luaH_getint(hvalue(t), k), \\n      !isempty(slot))) FULL_NAME=defs.h:luaV_fastgeti:ANY(4) SIGNATURE=ANY(4) ORDER=1
