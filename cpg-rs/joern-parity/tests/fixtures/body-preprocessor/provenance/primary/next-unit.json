      "affectedRealMethods": [
        "gz_open",
        "gzdopen",
        "gz_error"
      ]
    },
    {
      "title": "Phantom collection traverses inactive #if branches and condition identifiers",
      "severity": "medium compiler correctness",
      "confidence": "high; source plus fresh complete pinned graphs",
      "sourceLocations": [
        "cpg-rs/cpg-lang-c/src/exact.rs:2780",
        "cpg-rs/cpg-lang-c/src/exact.rs:2995",
        "cpg-rs/cpg-lang-c/src/exact.rs:3026"
      ],
      "cause": "walk_phantoms special-cases only preproc_ifdef; preproc_if falls through generic child traversal. Consequently both alternatives and defined-expression identifier names are visited.",
